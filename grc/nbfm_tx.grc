options:
  parameters:
    author: jim-p25
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: C++ NBFM transmit from 8 kHz s16le UDP 23459. LO +50 kHz, rotator
      down so the voice sits on freq. No Python work() source. Pi-ready.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: jim_nbfm_tx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: jim-p25 NBFM transmit
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 12]
    state: enabled

blocks:
- name: audio_rate
  id: variable
  parameters:
    comment: ''
    value: '8000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 12]
    state: enabled
- name: device_args
  id: variable
  parameters:
    comment: ''
    value: '"hackrf,buffers=64"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 76]
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: ''
    value: 100e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 12]
    state: enabled
- name: if_gain
  id: variable
  parameters:
    comment: ''
    value: '16'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 76]
    state: enabled
- name: max_dev
  id: variable
  parameters:
    comment: ''
    value: 2.5e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 76]
    state: enabled
- name: offset
  id: variable
  parameters:
    comment: ''
    value: 50e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 12]
    state: enabled
- name: ppm
  id: variable
  parameters:
    comment: ''
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 12]
    state: enabled
- name: quad_rate
  id: variable
  parameters:
    comment: ''
    value: '40000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 12]
    state: enabled
- name: rf_gain
  id: variable
  parameters:
    comment: ''
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 76]
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 12]
    state: enabled
- name: tau
  id: variable
  parameters:
    comment: ''
    value: 750e-6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 76]
    state: enabled
- name: udp_port
  id: variable
  parameters:
    comment: ''
    value: '23459'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 76]
    state: enabled
- name: import_math
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import math
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 88]
    state: enabled
- name: nbfm
  id: analog_nbfm_tx
  parameters:
    affinity: ''
    alias: ''
    audio_rate: audio_rate
    comment: ''
    fh: '-1.0'
    max_dev: max_dev
    maxoutbuf: '0'
    minoutbuf: '0'
    quad_rate: quad_rate
    tau: tau
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 264]
    state: enabled
- name: note_rpi
  id: note
  parameters:
    alias: ''
    comment: ''
    note: Feed 8000 Hz s16le PCM to UDP 23459 (320-byte frames). analog.nbfm_tx runs
      at 40 kHz, then interpolates to samp_rate. RF gain stays 0. On a Pi, keep device_args
      and IF gain modest.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [160, 80]
    state: enabled
