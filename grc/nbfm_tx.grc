    bus_source: false
    bus_structure: null
    coordinate: [1220, 256]
    state: enabled
- name: resamp
  id: rational_resampler_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    decim: '1'
    fbw: '0'
    interp: int(samp_rate / quad_rate)
    maxoutbuf: '0'
    minoutbuf: '0'
    taps: '[]'
    type: ccc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 272]
    state: enabled
- name: rotator
  id: blocks_rotator_cc
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    phase_inc: -2.0 * math.pi * offset / samp_rate
    tag_inc_update: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [980, 288]
    state: enabled
- name: s2f
  id: blocks_short_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    scale: '32768'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [260, 296]
    state: enabled
- name: udp_pcm
  id: network_udp_source
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    header: '0'
    ipv6: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    notify_missed: 'False'
    payloadsize: '320'
    port: udp_port
    src_zeros: 'True'
    type: short
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 280]
    state: enabled

connections:
- [nbfm, '0', resamp, '0']
- [resamp, '0', rotator, '0']
- [rotator, '0', osmo_sink, '0']
- [s2f, '0', nbfm, '0']
- [udp_pcm, '0', s2f, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
